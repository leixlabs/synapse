{
  "manifest_version": 3,
  "name": "Synapse Collector",
  "version": "1.0.0",
  "description": "Aggregate your thoughts from X.com, Bilibili, Weibo, QZone, Redbook, Douyin, ZSXQ, YouTube and WeChat to a local Synapse server",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://member.bilibili.com/*",
    "https://i0.hdslb.com/*",
    "https://i1.hdslb.com/*",
    "https://i2.hdslb.com/*",
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "https://m.weibo.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.qzone.qq.com/*",
    "https://user.qzone.qq.com/*",
    "https://www.xiaohongshu.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://creator.douyin.com/*",
    "https://*.douyinpic.com/*",
    "https://wx.zsxq.com/*",
    "https://*.zsxq.com/*",
    "https://www.youtube.com/*",
    "https://mp.weixin.qq.com/*",
    "https://*.qpic.cn/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["dist/content/x-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://member.bilibili.com/*"],
      "js": ["dist/content/bilibili-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.qzone.qq.com/*", "https://user.qzone.qq.com/*"],
      "js": ["dist/content/qzone-collector.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://weibo.com/*", "https://www.weibo.com/*", "https://m.weibo.com/*"],
      "js": ["dist/content/weibo-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["dist/content/redbook-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.douyin.com/*"],
      "js": ["dist/content/douyin-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://wx.zsxq.com/*", "https://*.zsxq.com/*"],
      "js": ["dist/content/zsxq-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content/youtube-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["dist/content/wxh-collector.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
