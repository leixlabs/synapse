<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Synapse Local Server — launchd Service

  Two separate data roots:
    --storage-root  content Markdown + images   (year/month/<day>-<platform>-<title>.md)
    --metrics-root  engagement metrics          (<platform>/<year>/<month>/<title>.md)

  SETUP:
    1. Build the binary:
         cd /Users/lei/dev/projects/2601-synapse/server
         go build -o synapse-server .
         mkdir -p ~/.local/bin && cp synapse-server ~/.local/bin/synapse-server

    2. Install and start:
         cp leix.synapse.server.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/leix.synapse.server.plist

    MANAGE:
         launchctl stop  leix.synapse.server
         launchctl start leix.synapse.server
         launchctl unload ~/Library/LaunchAgents/leix.synapse.server.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>leix.synapse.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lei/.local/bin/synapse-server</string>
        <string>--storage-root</string>
        <string>/Users/lei/dev/projects/2601-synapse/social-media-data</string>
        <string>--metrics-root</string>
        <string>/Users/lei/studio/social/metrics</string>
        <string>--port</string>
        <string>7070</string>
        <string>--host</string>
        <string>0.0.0.0</string>
    </array>

    <!-- Start at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>/tmp/synapse-server.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/synapse-server.error.log</string>

    <!-- Nice priority (low CPU impact when idle) -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
