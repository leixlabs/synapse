---
/**
 * ArchitectureMap — the whole Synapse pipeline on one page.
 *
 * Read from top to bottom: ten source buckets are parsed in the browser, POSTed
 * to a local Go daemon, written to two separate Markdown roots, flattened into
 * JSON, pre-rendered by Astro, and shipped as static assets to the edge.
 *
 * Only the last band leaves the machine, which is the point: the archive is a
 * folder, the website is a reader.
 */

const sourceChips = [
  { label: "X", dot: "var(--src-x)" },
  { label: "Bilibili", dot: "var(--src-bilibili)" },
  { label: "WeChat", dot: "var(--src-wechat)" },
  { label: "公众号", dot: "var(--src-wechat)" },
  { label: "知识星球", dot: "var(--src-zsxq)" },
  { label: "Weibo", dot: "var(--src-weibo)" },
  { label: "RedBook", dot: "var(--src-redbook)" },
  { label: "Douyin", dot: "var(--src-douyin)" },
  { label: "QZone", dot: "var(--src-qzone)" },
  { label: "YouTube", dot: "var(--src-youtube)" },
];

const bands = [
  {
    index: "01",
    name: "Capture",
    join: "",
    nodes: [
      {
        kicker: "Browser",
        title: "Ten source buckets",
        kind: "chips",
      },
      {
        arrow: "DOM",
        kicker: "Extension · MV3",
        title: "Synapse Collector",
        lines: [
          "content script per platform",
          "parses DOM → text, media, time",
          "popup · options · service worker",
          "activeTab, webNavigation",
        ],
      },
    ],
  },
  {
    index: "02",
    name: "Ingest",
    join: "HTTP POST · JSON + base64 media · localhost only",
    nodes: [
      {
        kicker: "Daemon · Go",
        title: "Local server",
        lines: [
          "127.0.0.1:7070",
          "POST /collect · /upsert",
          "GET /check · /stats · /tasks",
          "launchd job, single binary",
        ],
      },
      {
        arrow: "writes",
        kicker: "Writer",
        title: "Markdown + media",
        lines: [
          "one .md per item",
          "URL hash → stable ids",
          "base64 images decoded",
          "engagement split to metrics",
        ],
      },
    ],
  },
  {
    index: "03",
    name: "Store",
    join: "Two roots, never mixed",
    nodes: [
      {
        kicker: "Content root",
        title: "social-media-data/",
        lines: [
          "&lt;year&gt;/&lt;month&gt;/&lt;day&gt;-&lt;platform&gt;-&lt;title&gt;.md",
          "images/ beside each entry",
          "YAML front matter, committed to git",
        ],
      },
      {
        arrow: "and",
        kicker: "Metrics root",
        title: "~/studio/social/metrics/",
        lines: [
          "&lt;platform&gt;/&lt;year&gt;/&lt;month&gt;/&lt;day&gt;-&lt;title&gt;.md",
          "views · likes · comments · reposts",
          "content_path back-reference",
        ],
      },
    ],
  },
  {
    index: "04",
    name: "Build",
    join: "Markdown → JSON, at build time",
    nodes: [
      {
        kicker: "Build step",
        title: "sync-from-local.ts",
        lines: [
          "walks every .md file",
          "thoughts-by-year/{year}.json",
          "daily-counts.json",
          "copies images to public/data/",
        ],
      },
      {
        arrow: "JSON",
        kicker: "Render",
        title: "Astro · static output",
        lines: [
          "12 pages pre-rendered",
          "/ · /about · /source/[source]",
          "no database, no runtime",
        ],
      },
    ],
  },
  {
    index: "05",
    name: "Serve",
    join: "Static assets only — no origin server",
    nodes: [
      {
        kicker: "Host",
        title: "Cloudflare Workers",
        lines: ["wrangler deploy · dist/", "edge cache, global"],
      },
      {
        arrow: "URL",
        kicker: "Public host",
        title: "updates.leix.dev",
        kind: "endpoint",
      },
    ],
  },
];

const external = [
  { label: "fonts.loli.net", note: "Newsreader · Inter · JetBrains Mono" },
  { label: "jsDelivr", note: "remote media fallback" },
  { label: "@vercel/analytics", note: "pageviews, cookie-free" },
];
---

<figure class="arch" aria-labelledby="arch-caption">
  <div class="arch-head">
    <span class="arch-kicker">System map</span>
    <span class="arch-note">Ten sources in, one folder out</span>
  </div>

  <div class="arch-canvas">
    {
      bands.map((band, bandIndex) => (
        <>
          {bandIndex > 0 && (
            <div class="join">
              <span class="join-line" aria-hidden="true" />
              <span class="join-label">{band.join}</span>
            </div>
          )}

          <div class="band">
            <span class="band-index" aria-hidden="true">
              {band.index}
            </span>

            {band.nodes.map((node, nodeIndex) => (
              <>
                {nodeIndex > 0 && (
                  <span class="arrow">
                    <svg viewBox="0 0 36 8" fill="none" aria-hidden="true">
                      <path
                        d="M0 4h33M29.5 1 33 4l-3.5 3"
                        stroke="currentColor"
                        stroke-width="1"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {node.arrow && <span class="arrow-note">{node.arrow}</span>}
                  </span>
                )}

                <div class={`node ${node.kind === "endpoint" ? "is-endpoint" : ""}`}>
                  <p class="node-kicker">{node.kicker}</p>
                  <p class="node-title">{node.title}</p>

                  {node.kind === "chips" ? (
                    <ul class="chips">
                      {sourceChips.map((chip) => (
                        <li class="chip" style={`--dot: ${chip.dot}`}>
                          <span class="chip-dot" aria-hidden="true" />
                          {chip.label}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <ul class="node-lines">
                      {node.lines?.map((line) => (
                        <li set:html={line} />
                      ))}
                    </ul>
                  )}
                </div>
              </>
            ))}
          </div>
        </>
      ))
    }
  </div>

  <figcaption id="arch-caption" class="arch-foot">
    <p>
      Everything above the last band runs on one machine. The site never talks to
      a database — it is rebuilt from the Markdown and published as flat files.
    </p>
    <ul class="external">
      <li class="ext-label">External</li>
      {
        external.map((item) => (
          <li>
            <b>{item.label}</b>
            <span class="muted">— {item.note}</span>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<style>
  .arch {
    margin: var(--space-10) 0 0;
    padding: var(--space-6) var(--space-6) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .arch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-5);
  }

  .arch-kicker {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .arch-note {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  /* Bands ----------------------------------------------------------------- */
  .band {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .band-index {
    flex: 0 0 26px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-top: 15px;
  }

  .node {
    flex: 1 1 0;
    min-width: 0;
    padding: 14px 16px 15px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .node.is-endpoint {
    flex: 0 1 200px;
    border-style: dashed;
    background: transparent;
  }

  .node-kicker {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 5px;
  }

  .node-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .node-lines {
    list-style: none;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .node-lines li {
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  /* Source chips ---------------------------------------------------------- */
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 11px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dot, var(--ink-faint));
    flex: none;
  }

  /* Arrows between nodes of one band -------------------------------------- */
  .arrow {
    flex: 0 0 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: var(--ink-faint);
  }

  .arrow svg {
    width: 34px;
    height: 8px;
  }

  .arrow-note {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  /* Connector between bands ----------------------------------------------- */
  .join {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0 9px 26px;
    min-height: 36px;
  }

  .join-line {
    position: absolute;
    left: 26px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule-strong);
  }

  .join-line::after {
    content: "";
    position: absolute;
    left: -2px;
    bottom: 1px;
    width: 5px;
    height: 5px;
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    transform: rotate(45deg);
  }

  .join-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    padding-left: 14px;
  }

  /* Caption --------------------------------------------------------------- */
  .arch-foot {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .arch-foot p {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .external {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 22px;
    margin-top: var(--space-4);
  }

  .external li {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ink-soft);
  }

  .external .ext-label {
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .external b {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .external .muted {
    color: var(--ink-faint);
    letter-spacing: 0.01em;
  }

  /* Mobile ---------------------------------------------------------------- */
  @media (max-width: 760px) {
    .arch {
      padding: var(--space-5) var(--space-4);
    }

    .band {
      flex-direction: column;
      align-items: stretch;
    }

    .band-index {
      flex: none;
      padding: 0 0 6px;
    }

    .node,
    .node.is-endpoint {
      flex: none;
      width: 100%;
    }

    .arrow {
      flex: none;
      width: 100%;
      height: 34px;
      flex-direction: row;
      gap: 8px;
    }

    .arrow svg {
      transform: rotate(90deg);
    }

    .arrow-note {
      font-size: 0.5625rem;
    }

    .join {
      padding-left: 0;
      min-height: 0;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .join-line {
      display: none;
    }

    .join-label {
      padding-left: 0;
    }
  }
</style>
