---
interface Props {
  data: { date: string; count: number }[];
}

const { data } = Astro.props;
const serializedData = JSON.stringify(data);
---

<section class="heatmap" id="heatmap-root" data-activity={serializedData}>
  <div class="heatmap-head">
    <span class="eyebrow">Activity</span>
    <div class="year-switch">
      <button
        id="heatmap-prev"
        class="year-btn"
        type="button"
        aria-label="Previous year"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M14.5 6.5 9 12l5.5 5.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <span id="heatmap-year-display" class="year-display mono"></span>
      <button
        id="heatmap-next"
        class="year-btn"
        type="button"
        aria-label="Next year"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M9.5 6.5 15 12l-5.5 5.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="heatmap-scroll">
    <div class="heatmap-cal">
      <div class="heatmap-weekdays" aria-hidden="true">
        <span></span><span>Mon</span><span></span><span>Wed</span><span></span
        ><span>Fri</span><span></span>
      </div>
      <div class="heatmap-plot">
        <div class="heatmap-months" id="heatmap-months" aria-hidden="true"></div>
        <div class="heatmap-grid" id="heatmap-grid">
          <!-- Grid injected by script -->
        </div>
      </div>
    </div>
  </div>

  <div class="heatmap-foot">
    <span id="heatmap-total-text" class="heatmap-total"></span>
    <div class="heatmap-legend">
      <span class="legend-label">Less</span>
      <div class="heatmap-day level-0"></div>
      <div class="heatmap-day level-1"></div>
      <div class="heatmap-day level-2"></div>
      <div class="heatmap-day level-3"></div>
      <div class="heatmap-day level-4"></div>
      <span class="legend-label">More</span>
    </div>
  </div>

  <div id="heatmap-tooltip" class="heatmap-tooltip hidden"></div>
</section>

<script>
  const root = document.getElementById("heatmap-root");
  const grid = document.getElementById("heatmap-grid");
  const monthsEl = document.getElementById("heatmap-months");
  const yearDisplay = document.getElementById("heatmap-year-display");
  const prevBtn = document.getElementById("heatmap-prev");
  const nextBtn = document.getElementById("heatmap-next");
  const totalText = document.getElementById("heatmap-total-text");
  const tooltip = document.getElementById("heatmap-tooltip");

  const MONTHS = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];

  if (root && grid && yearDisplay) {
    const rawData = JSON.parse(root.getAttribute("data-activity") || "[]");

    // Grouping by local date parts to avoid UTC shift
    const dataByYear: Record<number, { date: string; count: number }[]> = {};
    rawData.forEach((d: any) => {
      const parts = d.date.split("-");
      const year = parseInt(parts[0]);
      if (!dataByYear[year]) dataByYear[year] = [];
      dataByYear[year].push(d);
    });

    const years = Object.keys(dataByYear)
      .map(Number)
      .sort((a, b) => b - a);
    let currentYearIndex = 0;
    let selectedDate = "";
    let didInitialScroll = false;

    function getLevel(count: number): number {
      if (count <= 0) return 0;
      if (count === 1) return 1;
      if (count <= 3) return 2;
      if (count <= 5) return 3;
      return 4;
    }

    // Helper for generating local YYYY-MM-DD strings
    function getDateKey(year: number, month: number, day: number) {
      return `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    }

    function renderMonths(weeks: any[][]) {
      if (!monthsEl) return;
      const labels: { i: number; label: string }[] = [];
      let lastMonth = -1;
      let lastIndex = -10;

      weeks.forEach((week, i) => {
        const first = week.find((d) => d.date);
        if (!first) return;
        const m = parseInt(first.date.slice(5, 7), 10);
        if (m !== lastMonth && i - lastIndex >= 2) {
          labels.push({ i, label: MONTHS[m - 1] });
          lastMonth = m;
          lastIndex = i;
        }
      });

      monthsEl.innerHTML = labels
        .map((l) => `<span style="--i:${l.i}">${l.label}</span>`)
        .join("");
    }

    function renderHeatmap() {
      const year =
        years.length > 0 ? years[currentYearIndex] : new Date().getFullYear();
      yearDisplay!.textContent = year.toString();

      const yearData = dataByYear[year] || [];
      const totalInYear = yearData.reduce((sum, d) => sum + d.count, 0);
      totalText!.textContent = `${totalInYear} thoughts in ${year}`;

      if (prevBtn)
        (prevBtn as HTMLButtonElement).disabled =
          currentYearIndex === years.length - 1 || years.length <= 1;
      if (nextBtn)
        (nextBtn as HTMLButtonElement).disabled =
          currentYearIndex === 0 || years.length <= 1;

      const countsMap = new Map(yearData.map((d) => [d.date, d.count]));

      const weeks: any[][] = [];
      let currentWeek: any[] = [];

      // Logic: Iterate every day of the year manually
      const firstDay = new Date(year, 0, 1);
      const startPadding = firstDay.getDay();

      // Pad beginning
      for (let i = 0; i < startPadding; i++) {
        currentWeek.push({ date: "", count: -1 });
      }

      // Loop through all days of the year precisely
      // Using month/day instead of Date addition to avoid DST issues
      for (let m = 0; m < 12; m++) {
        const daysInMonth = new Date(year, m + 1, 0).getDate();
        for (let d = 1; d <= daysInMonth; d++) {
          const key = getDateKey(year, m, d);
          currentWeek.push({ date: key, count: countsMap.get(key) || 0 });

          if (currentWeek.length === 7) {
            weeks.push(currentWeek);
            currentWeek = [];
          }
        }
      }

      if (currentWeek.length > 0) {
        while (currentWeek.length < 7) {
          currentWeek.push({ date: "", count: -1 });
        }
        weeks.push(currentWeek);
      }

      let html = "";
      weeks.forEach((week) => {
        html += `<div class="heatmap-week">`;
        week.forEach((day) => {
          if (day.count === -1) {
            html += `<div class="heatmap-day level-empty"></div>`;
          } else {
            const isSelected = day.date === selectedDate;
            html += `<div class="heatmap-day level-${getLevel(day.count)} ${isSelected ? "selected" : ""}" data-date="${day.date}" data-count="${day.count}"></div>`;
          }
        });
        html += `</div>`;
      });

      grid!.innerHTML = html;
      renderMonths(weeks);

      // On narrow screens the calendar overflows: start at the most recent week.
      if (!didInitialScroll) {
        didInitialScroll = true;
        const scroller = root.querySelector(".heatmap-scroll");
        if (scroller && scroller.scrollWidth > scroller.clientWidth + 4) {
          scroller.scrollLeft = scroller.scrollWidth;
        }
      }

      // Tooltip and Click listeners
      const dayEls = grid!.querySelectorAll(".heatmap-day[data-date]");
      dayEls.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          const date = el.getAttribute("data-date");
          const count = el.getAttribute("data-count");
          if (!date || !tooltip) return;
          tooltip.textContent = `${date} · ${count} thought${count !== "1" ? "s" : ""}`;
          tooltip.classList.remove("hidden");
        });

        el.addEventListener("mousemove", (e: any) => {
          if (!tooltip) return;
          tooltip.style.left = `${e.clientX + 12}px`;
          tooltip.style.top = `${e.clientY - 32}px`;
        });

        el.addEventListener("mouseleave", () =>
          tooltip?.classList.add("hidden"),
        );

        el.addEventListener("click", () => {
          const date = el.getAttribute("data-date");
          if (!date) return;

          selectedDate = selectedDate === date ? "" : date;

          renderHeatmap();

          // Dispatch event for Filtering
          window.dispatchEvent(
            new CustomEvent("filter-date", { detail: selectedDate }),
          );
        });
      });
    }

    prevBtn?.addEventListener("click", () => {
      if (currentYearIndex < years.length - 1) {
        currentYearIndex++;
        renderHeatmap();
      }
    });

    nextBtn?.addEventListener("click", () => {
      if (currentYearIndex > 0) {
        currentYearIndex--;
        renderHeatmap();
      }
    });

    window.addEventListener("clear-calendar-selection", () => {
      selectedDate = "";
      renderHeatmap();
    });

    renderHeatmap();
  }
</script>

<style is:global>
  /* Global on purpose: the calendar cells are injected at runtime and would not
     carry Astro's scoped data attribute. Every selector is namespaced. */
  .heatmap {
    --hm-cell: 11px;
    --hm-gap: 3px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: 18px 20px 16px;
    max-width: 100%;
  }

  .heatmap-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .year-switch {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .year-display {
    min-width: 42px;
    text-align: center;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .year-btn {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: var(--ink-faint);
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .year-btn svg {
    width: 15px;
    height: 15px;
  }

  .year-btn:hover:not(:disabled) {
    color: var(--ink);
    background: var(--paper-sunken);
  }

  .year-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .heatmap-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 2px;
    scrollbar-width: thin;
  }

  .heatmap-cal {
    display: flex;
    gap: 8px;
    width: max-content;
  }

  .heatmap-weekdays {
    display: flex;
    flex-direction: column;
    gap: var(--hm-gap);
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    position: sticky;
    left: 0;
    background: var(--paper-raised);
    z-index: 2;
    padding-right: 2px;
  }

  .heatmap-weekdays span {
    height: var(--hm-cell);
    line-height: var(--hm-cell);
  }

  .heatmap-plot {
    display: flex;
    flex-direction: column;
  }

  .heatmap-months {
    position: relative;
    height: 14px;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .heatmap-months span {
    position: absolute;
    top: 0;
    left: calc(var(--i) * (var(--hm-cell) + var(--hm-gap)));
    white-space: nowrap;
  }

  .heatmap-grid {
    display: flex;
    gap: var(--hm-gap);
  }

  .heatmap-week {
    display: flex;
    flex-direction: column;
    gap: var(--hm-gap);
    flex: none;
  }

  .heatmap-day {
    width: var(--hm-cell);
    height: var(--hm-cell);
    border-radius: 2px;
    background: var(--hm-0);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    cursor: pointer;
  }

  .heatmap-day.level-empty {
    visibility: hidden;
  }

  .heatmap-day:hover:not(.level-empty) {
    transform: scale(1.35);
    box-shadow: 0 0 0 1px var(--ink);
    z-index: 5;
  }

  .heatmap-day.selected {
    box-shadow: 0 0 0 1.5px var(--ink);
    transform: scale(1.15);
  }

  .heatmap-day.level-1 {
    background: var(--hm-1);
  }
  .heatmap-day.level-2 {
    background: var(--hm-2);
  }
  .heatmap-day.level-3 {
    background: var(--hm-3);
  }
  .heatmap-day.level-4 {
    background: var(--hm-4);
  }

  .heatmap-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .heatmap-legend .heatmap-day {
    width: 9px;
    height: 9px;
    cursor: default;
  }

  .heatmap-legend .heatmap-day:hover {
    transform: none;
    box-shadow: none;
  }

  .legend-label {
    margin: 0 3px;
  }

  .heatmap-tooltip {
    position: fixed;
    background: var(--ink);
    color: var(--paper);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    pointer-events: none;
    z-index: 1000;
    white-space: nowrap;
    box-shadow: var(--shadow-md);
  }

  .heatmap-tooltip.hidden {
    display: none !important;
  }

  @media (max-width: 720px) {
    .heatmap {
      --hm-cell: 10px;
      --hm-gap: 2px;
      padding: 14px 14px 12px;
    }

    .heatmap-weekdays {
      display: none;
    }

    .heatmap-weekdays + .heatmap-plot {
      padding-top: 0;
    }
  }
</style>
