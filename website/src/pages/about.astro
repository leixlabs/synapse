---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchitectureMap from "../components/ArchitectureMap.astro";
import { GITHUB_URL } from "../lib/site";

const steps = [
  {
    title: "Collect",
    body: "A small browser extension reads the page you are already on — a post, a video, a note — and picks out the text, the media and the timestamp.",
  },
  {
    title: "Normalize",
    body: "Every source is flattened into one shape: the same front matter, the same field names, the same folder convention. Nothing to reconcile later.",
  },
  {
    title: "Archive",
    body: "The result is written to plain Markdown on your own disk, next to the images it references. This site is just a reader on top of those files.",
  },
];

const sources = [
  { name: "X", note: "posts & replies", dot: "--src-x" },
  { name: "Bilibili", note: "dynamics & video", dot: "--src-bilibili" },
  { name: "WeChat", note: "公众号 articles", dot: "--src-wechat" },
  { name: "知识星球", note: "posts & comments", dot: "--src-zsxq" },
  { name: "Weibo", note: "posts & threads", dot: "--src-weibo" },
  { name: "RedBook", note: "notes & galleries", dot: "--src-redbook" },
  { name: "Douyin", note: "works & stats", dot: "--src-douyin" },
  { name: "QZone", note: "feeds & albums", dot: "--src-qzone" },
  { name: "YouTube", note: "videos", dot: "--src-youtube" },
];

const guarantees = [
  {
    title: "No lock-in",
    body: "Content lives as .md files with YAML front matter. Open them in Obsidian, grep them, commit them — the archive outlives the app.",
  },
  {
    title: "Media stays with the text",
    body: "Images are downloaded and stored beside the entry when possible, with the original URL kept as a fallback.",
  },
  {
    title: "Two roots, on purpose",
    body: "Entries and engagement metrics (views, likes, collects) are written separately, so a repost never overwrites what you wrote.",
  },
  {
    title: "Read-only by design",
    body: "The website is a static build. It reads the archive, renders it, and ships nothing else — no database, no server to keep alive.",
  },
];
---

<BaseLayout
  title="About"
  description="Synapse captures the moments you want to keep from across social media and archives them as plain Markdown on your own disk."
>
  <div class="about">
    <header class="about-hero">
      <div class="inner">
        <p class="eyebrow">The product</p>
        <h1>Every brilliant thought,<br />synchronized.</h1>
        <p class="lede">
          Stop losing insights to the scroll. Synapse captures the moments you
          want to keep from across social media and files them away — as plain
          text, on your own disk.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/">
            <span>Read the archive</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            class="btn btn-ghost"
            href={GITHUB_URL}
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 1.8a10.2 10.2 0 0 0-3.23 19.88c.51.09.7-.22.7-.49v-1.9c-2.84.62-3.44-1.2-3.44-1.2-.46-1.18-1.13-1.5-1.13-1.5-.93-.63.07-.62.07-.62 1.02.08 1.56 1.05 1.56 1.05.91 1.56 2.39 1.11 2.97.85.09-.66.36-1.11.65-1.37-2.27-.26-4.65-1.14-4.65-5.05 0-1.12.4-2.03 1.05-2.75-.11-.26-.46-1.3.1-2.71 0 0 .86-.27 2.8 1.05a9.7 9.7 0 0 1 5.1 0c1.94-1.32 2.8-1.05 2.8-1.05.56 1.41.21 2.45.1 2.71.65.72 1.05 1.63 1.05 2.75 0 3.92-2.39 4.79-4.67 5.04.37.32.7.94.7 1.9v2.82c0 .27.18.59.71.49A10.2 10.2 0 0 0 12 1.8Z"
              ></path>
            </svg>
            <span>View source</span>
          </a>
        </div>

        <ul class="hero-meta">
          <li>Local-first</li>
          <li>Markdown</li>
          <li>Self-hosted</li>
        </ul>
      </div>
    </header>

    <div class="inner">
      <hr class="rule" />
    </div>

    <section class="chapter">
      <div class="inner chapter-grid">
        <div class="chapter-label">
          <span class="num">01</span>
          <span class="name">The problem</span>
        </div>
        <div class="chapter-body">
          <h2>Your best ideas are spread across five feeds.</h2>
          <p>
            A thread on X, a video that changed how you think about something, a
            note you wrote at 2am. Each one lives in a different app with a
            different search box, and none of them are yours.
          </p>
          <p>
            Bookmarks rot. Screenshots pile up unreadable. And the platforms
            that hold your thinking are not in the business of giving it back.
            Synapse exists to take the keepers out of the feed and put them
            somewhere durable.
          </p>
        </div>
      </div>
    </section>

    <section class="chapter">
      <div class="inner chapter-grid">
        <div class="chapter-label">
          <span class="num">02</span>
          <span class="name">How it works</span>
        </div>
        <div class="chapter-body">
          <h2>Three steps, mostly invisible.</h2>
          <ol class="steps">
            {
              steps.map((step, index) => (
                <li class="step">
                  <span class="step-index">{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="chapter" id="architecture">
      <div class="inner">
        <div class="chapter-grid">
          <div class="chapter-label">
            <span class="num">03</span>
            <span class="name">Architecture</span>
          </div>
          <div class="chapter-body">
            <h2>The whole system, in five bands.</h2>
            <p>
              Four moving parts and one folder. A browser extension reads the
              page you are already on, a local daemon writes it to disk, a build
              step flattens those files into JSON, and a static site renders
              them. Nothing is held in a database, and nothing on this site needs
              a server to stay awake.
            </p>
          </div>
        </div>

        <ArchitectureMap />
      </div>
    </section>

    <section class="chapter">
      <div class="inner chapter-grid">
        <div class="chapter-label">
          <span class="num">04</span>
          <span class="name">What you get</span>
        </div>
        <div class="chapter-body">
          <h2>A folder you actually own.</h2>
          <dl class="guarantees">
            {
              guarantees.map((item) => (
                <div class="guarantee">
                  <dt>{item.title}</dt>
                  <dd>{item.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="chapter">
      <div class="inner chapter-grid">
        <div class="chapter-label">
          <span class="num">05</span>
          <span class="name">Sources</span>
        </div>
        <div class="chapter-body">
          <h2>Where it collects from.</h2>
          <ul class="source-list">
            {
              sources.map((source) => (
                <li>
                  <span class="source-name">
                    <span
                      class="source-dot"
                      style={`--dot: var(${source.dot})`}
                      aria-hidden="true"
                    />
                    {source.name}
                  </span>
                  <span class="source-note">{source.note}</span>
                </li>
              ))
            }
          </ul>
          <p class="source-foot">
            Adding a source is a single collector file — the popup discovers it
            automatically. Entries imported from WeChat before the collector
            existed carry the legacy label <em>公众号</em>; both resolve to the
            same platform.
          </p>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="inner">
        <p class="eyebrow">Start here</p>
        <h2 class="closing-title">
          The archive is public.<br />Go and read something.
        </h2>
        <a class="btn btn-primary" href="/">
          <span>Open Thoughts</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  @media (max-width: 640px) {
    .inner {
      padding: 0 var(--space-4);
    }
  }

  /* Hero ------------------------------------------------------------------ */
  .about-hero {
    padding: var(--space-20) 0 var(--space-16);
  }

  .about-hero h1 {
    font-size: clamp(2.5rem, 6.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 18px 0 24px;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-8);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-8);
    list-style: none;
  }

  .hero-meta li {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    padding: 4px 10px;
  }

  /* Chapters -------------------------------------------------------------- */
  .chapter {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--rule);
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 820px) {
    .chapter-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .chapter-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  @media (max-width: 820px) {
    .chapter-label {
      position: static;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
  }

  .chapter-label .num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .chapter-label .name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .chapter-body h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-5);
  }

  .chapter-body p {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .chapter-body p + p {
    margin-top: var(--space-4);
  }

  /* Steps ----------------------------------------------------------------- */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin-top: var(--space-8);
  }

  .step {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--rule);
  }

  .step:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .step-index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-top: 4px;
  }

  .step h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .step p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 56ch;
  }

  /* Guarantees ------------------------------------------------------------ */
  .guarantees {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-8);
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .guarantees {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .guarantee {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .guarantee dt {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .guarantee dd {
    font-size: 0.875rem;
    line-height: 1.68;
    color: var(--ink-muted);
  }

  /* Sources --------------------------------------------------------------- */
  .source-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .source-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .source-name {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .source-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dot, var(--ink-faint));
    flex: none;
  }

  .source-note {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .source-foot {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ink-faint);
    max-width: 62ch;
  }

  .source-foot em {
    font-style: italic;
    color: var(--ink-muted);
  }

  /* Closing --------------------------------------------------------------- */
  .closing {
    padding: var(--space-20) 0 var(--space-16);
    border-top: 1px solid var(--rule);
  }

  .closing-title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 14px 0 var(--space-8);
  }
</style>
