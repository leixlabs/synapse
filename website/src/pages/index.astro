---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThoughtCard from "../components/ThoughtCard.astro";
import Heatmap from "../components/Heatmap.astro";
import TimelineScroll from "../components/TimelineScroll.astro";
import {
  buildThoughtYearMeta,
  loadAllThoughts,
  loadDailyCounts,
  loadThoughtsIndex,
} from "../lib/thoughts-data";
import { SOURCE_META, sourceMeta } from "../lib/sources";

const thoughts = await loadAllThoughts();
const dailyCounts = await loadDailyCounts();
const thoughtsYearMeta = loadThoughtsIndex();
const thoughtYearMetaForClient =
  thoughtsYearMeta.length > 0 ? thoughtsYearMeta : buildThoughtYearMeta(thoughts);

// PERFORMANCE OPTIMIZATION:
// Only render the initial batch on SSR to keep the HTML payload small.
const INITIAL_RENDER_COUNT = 20;
const initialThoughts = thoughts.slice(0, INITIAL_RENDER_COUNT);

// Source tally for the filter bar
const tally = new Map<string, number>();
for (const thought of thoughts) {
  const key = thought.source.toLowerCase();
  tally.set(key, (tally.get(key) ?? 0) + 1);
}

const sources = [...tally.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([raw, count]) => {
    const meta = sourceMeta(raw);
    return { raw, label: meta.label, color: meta.color, count };
  });

const years = [
  ...new Set(
    thoughts
      .map((thought) => String(thought.originalDate).slice(0, 4))
      .filter((year) => /^\d{4}$/.test(year)),
  ),
].sort();

const yearLabel =
  years.length > 1
    ? `${years[0]} — ${years[years.length - 1]}`
    : years[0] ?? "—";
---

<BaseLayout
  title="Thoughts"
  description="A personal archive of everything worth keeping — collected from X, Bilibili and QZone, and kept in the open."
>
  <div class="page">
    <div class="shell">
      <aside class="rail">
        <TimelineScroll thoughts={thoughts as any} />
      </aside>

      <div class="col">
        <header class="page-head">
          <p class="eyebrow">Personal archive</p>
          <h1>Thoughts</h1>
          <p class="lede">
            Everything I read, watch and think about — pulled in automatically
            from across the web and kept here, in the open.
          </p>

          <dl class="head-stats">
            <div>
              <dt>Entries</dt>
              <dd>{thoughts.length}</dd>
            </div>
            <div>
              <dt>Sources</dt>
              <dd>{sources.length}</dd>
            </div>
            <div>
              <dt>Since</dt>
              <dd>{yearLabel}</dd>
            </div>
          </dl>
        </header>

        <section class="activity" aria-label="Activity">
          <Heatmap data={dailyCounts} />
        </section>

        <div class="toolbar" id="toolbar">
          <div class="chips" role="group" aria-label="Filter by source">
            <button
              class="chip is-active"
              type="button"
              data-source="all"
              aria-pressed="true"
              title={`${thoughts.length} entries`}
            >
              All
            </button>
            {
              sources.map((source) => (
                <button
                  class="chip"
                  type="button"
                  data-source={source.raw}
                  aria-pressed="false"
                  title={`${source.count} entries from ${source.label}`}
                >
                  <span
                    class="chip-dot"
                    style={`--dot: ${source.color}`}
                    aria-hidden="true"
                  />
                  {source.label}
                </button>
              ))
            }
          </div>

          <div class="toolbar-right">
            <span id="feed-status" class="feed-status" hidden></span>
            <button id="clear-filters" class="clear-btn" type="button" hidden>
              Clear
            </button>
          </div>
        </div>

        {
          thoughts.length === 0 ? (
            <div class="empty-state">
              <p class="empty-title">No thoughts yet</p>
              <p class="empty-note">
                Start collecting from X, Bilibili or QZone and they will appear
                here.
              </p>
            </div>
          ) : (
            <>
              <div class="feed" id="thoughts-timeline">
                {initialThoughts.map((thought) => (
                  <ThoughtCard thought={thought as any} />
                ))}
              </div>

              <p id="feed-empty" class="empty-state" hidden>
                <span class="empty-title">Nothing matches this filter</span>
                <span class="empty-note"
                  >Try another source, or clear the date selection.</span
                >
              </p>

              <div id="loading-indicator" class="loading-indicator hidden">
                <span class="loading-dot"></span>
                <span>Loading more</span>
              </div>

              <div id="load-more-sentinel" class="load-more-sentinel"></div>
            </>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script
  define:vars={{
    initialThoughtsData: initialThoughts,
    thoughtYearMetaData: thoughtYearMetaForClient,
    thoughtsTotalCount: thoughts.length,
    sourceMetaData: SOURCE_META,
  }}
>
  window.__INITIAL_THOUGHTS__ = initialThoughtsData;
  window.__THOUGHT_YEAR_META__ = thoughtYearMetaData;
  window.__THOUGHTS_TOTAL__ = thoughtsTotalCount;
  window.__SOURCE_META__ = sourceMetaData;
</script>

<script>
  const INITIAL_THOUGHTS = (window as any).__INITIAL_THOUGHTS__ || [];
  const THOUGHT_YEAR_META = (window as any).__THOUGHT_YEAR_META__ || [];
  const THOUGHTS_TOTAL = Number((window as any).__THOUGHTS_TOTAL__ || 0);
  const SOURCE_MAP = (window as any).__SOURCE_META__ || {};
  const THOUGHTS_BY_YEAR_BASE = "/data/thoughts-by-year";

  const feedEl = document.getElementById("thoughts-timeline");
  const loadingEl = document.getElementById("loading-indicator");
  const sentinel = document.getElementById("load-more-sentinel");
  const statusEl = document.getElementById("feed-status");
  const clearBtn = document.getElementById("clear-filters");
  const emptyEl = document.getElementById("feed-empty");
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".chip"),
  );

  const BATCH_SIZE = 20;
  const INITIAL_RENDER = 20;

  const pool: any[] = [];
  const seen = new Set<string>();
  const yearCache = new Map<string, any[]>();
  const loadedYears = new Set<string>();
  const yearStartIndex = new Map<string, number>();

  let cursor = Math.min(INITIAL_RENDER, THOUGHTS_TOTAL);
  let busy = false;
  let allLoaded = false;
  let activeSource = "all";
  let activeDate = "";

  let cumulative = 0;
  THOUGHT_YEAR_META.forEach((entry: any) => {
    yearStartIndex.set(String(entry.year), cumulative);
    cumulative += Number(entry.count) || 0;
  });

  const keyOf = (thought: any): string =>
    thought.hashId
      ? `hash:${thought.hashId}`
      : thought.id
        ? `id:${thought.id}`
        : `fallback:${thought.originalDate}:${thought.source}:${thought.title ?? ""}`;

  function addToPool(list: any[]) {
    for (const thought of list) {
      const key = keyOf(thought);
      if (seen.has(key)) continue;
      seen.add(key);
      pool.push(thought);
    }
  }

  addToPool(INITIAL_THOUGHTS);

  async function loadYear(year: string): Promise<any[]> {
    if (yearCache.has(year)) return yearCache.get(year) || [];
    try {
      const response = await fetch(`${THOUGHTS_BY_YEAR_BASE}/${year}.json`, {
        cache: "force-cache",
      });
      if (!response.ok) {
        throw new Error(`Failed to load thoughts for ${year}`);
      }
      const data = await response.json();
      const list = Array.isArray(data) ? data : [];
      yearCache.set(year, list);
      return list;
    } catch (error) {
      console.error(error);
      yearCache.set(year, []);
      return [];
    }
  }

  async function ensureLoadedUntil(targetIndex: number) {
    for (const entry of THOUGHT_YEAR_META) {
      if (allLoaded || pool.length > targetIndex) return;
      const year = String(entry.year);
      if (loadedYears.has(year)) continue;
      loadedYears.add(year);
      addToPool(await loadYear(year));
    }
  }

  async function loadEverything() {
    if (allLoaded) return;
    for (const entry of THOUGHT_YEAR_META) {
      const year = String(entry.year);
      if (loadedYears.has(year)) continue;
      loadedYears.add(year);
      addToPool(await loadYear(year));
    }
    allLoaded = true;
  }

  // --- Rendering ---------------------------------------------------------
  const ESCAPES: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  };

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ESCAPES[c]);
  }

  const ARROW_SVG =
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M17 7H9m8 0v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function metaFor(raw: string) {
    const key = String(raw ?? "").toLowerCase();
    return (
      SOURCE_MAP[key] ?? {
        key: "other",
        label: raw || "Other",
        color: "var(--ink-faint)",
      }
    );
  }

  function cardHTML(thought: any): string {
    const sourceKey = String(thought.source).toLowerCase();
    const meta = metaFor(thought.source);
    const images = Array.isArray(thought.images) ? thought.images : [];
    const videos = Array.isArray(thought.videos) ? thought.videos : [];
    const tags = Array.isArray(thought.tags) ? thought.tags : [];
    const mediaCount = images.length + videos.length;

    const formattedDate = new Date(thought.originalDate).toLocaleDateString(
      "en-US",
      { year: "numeric", month: "short", day: "numeric" },
    );
    const dateISO = String(thought.originalDate).split("T")[0];

    const media = mediaCount
      ? `<div class="card-media" data-count="${mediaCount}">${images
          .map(
            (src: string) =>
              `<img src="${esc(src)}" alt="" loading="lazy" decoding="async">`,
          )
          .join("")}${videos
          .map(
            (src: string) =>
              `<video src="${esc(src)}" controls preload="none"></video>`,
          )
          .join("")}</div>`
      : "";

    const tagsHTML = tags.length
      ? `<footer class="card-foot">${tags
          .map((tag: string) => `<span class="tag">${esc(tag)}</span>`)
          .join("")}</footer>`
      : "";

    const link =
      thought.originalUrl && /^https?:\/\//.test(thought.originalUrl)
        ? `<a class="entry-link" href="${esc(thought.originalUrl)}" target="_blank" rel="noopener" aria-label="Open original post in a new tab"><span>Original</span>${ARROW_SVG}</a>`
        : "";

    return `<article class="thought-card" data-date="${dateISO}" data-source="${sourceKey}"><header class="card-meta"><span class="source source-${meta.key}" style="--dot: ${meta.color}"><span class="source-dot" aria-hidden="true"></span>${esc(meta.label)}</span><span class="meta-sep" aria-hidden="true">·</span><time datetime="${esc(thought.originalDate)}">${formattedDate}</time>${link}</header><div class="card-body">${thought.content ? `<p>${esc(thought.content)}</p>` : ""}${media}</div>${tagsHTML}</article>`;
  }

  function appendRange(from: number, to: number) {
    const slice = pool.slice(from, to);
    if (!slice.length || !feedEl) return;
    feedEl.insertAdjacentHTML("beforeend", slice.map(cardHTML).join(""));
  }

  function paint(list: any[]) {
    if (!feedEl) return;
    feedEl.innerHTML = list.map(cardHTML).join("");
    feedEl.classList.toggle("is-empty", list.length === 0);
  }

  // --- Filtering ---------------------------------------------------------
  function isFiltered() {
    return activeSource !== "all" || Boolean(activeDate);
  }

  function matches(thought: any) {
    if (
      activeSource !== "all" &&
      String(thought.source).toLowerCase() !== activeSource
    ) {
      return false;
    }
    if (activeDate && String(thought.originalDate).split("T")[0] !== activeDate) {
      return false;
    }
    return true;
  }

  function syncChips() {
    for (const chip of chips) {
      const on = chip.dataset.source === activeSource;
      chip.classList.toggle("is-active", on);
      chip.setAttribute("aria-pressed", String(on));
    }
  }

  function updateStatus() {
    if (!statusEl) return;
    // The archive stats already show the total; only surface a count while a
    // filter is narrowing the feed.
    if (!isFiltered()) {
      statusEl.hidden = true;
      statusEl.textContent = "";
    }
  }

  async function applyFilters() {
    if (isFiltered()) {
      sentinel?.classList.add("hidden");
      loadingEl?.classList.add("hidden");
      await loadEverything();
      const list = pool.filter(matches);
      paint(list);
      if (emptyEl) emptyEl.hidden = list.length > 0;
      if (statusEl) {
        statusEl.textContent = `${list.length} ${list.length === 1 ? "entry" : "entries"}`;
        statusEl.hidden = false;
      }
      if (clearBtn) clearBtn.hidden = false;
      return;
    }

    paint(pool.slice(0, cursor));
    if (emptyEl) emptyEl.hidden = true;
    if (clearBtn) clearBtn.hidden = true;
    sentinel?.classList.remove("hidden");
    updateStatus();
  }

  function resetFilters() {
    activeSource = "all";
    activeDate = "";
    syncChips();
    window.dispatchEvent(new CustomEvent("clear-calendar-selection"));
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const next = chip.dataset.source || "all";
      activeSource = activeSource === next ? "all" : next;
      syncChips();
      void applyFilters();
    });
  });

  clearBtn?.addEventListener("click", () => {
    resetFilters();
    void applyFilters();
  });

  window.addEventListener("filter-date", (event: any) => {
    activeDate = event.detail || "";
    void applyFilters();
  });

  // --- Infinite scroll ---------------------------------------------------
  async function loadMoreThoughts() {
    if (busy || isFiltered()) return;
    if (cursor >= THOUGHTS_TOTAL) {
      sentinel?.classList.add("hidden");
      return;
    }

    busy = true;
    loadingEl?.classList.remove("hidden");

    try {
      const before = pool.length;
      const end = Math.min(cursor + BATCH_SIZE, THOUGHTS_TOTAL);
      await ensureLoadedUntil(end - 1);

      if (pool.length <= before && pool.length <= cursor) {
        sentinel?.classList.add("hidden");
        return;
      }

      appendRange(cursor, Math.min(end, pool.length));
      cursor = Math.min(end, pool.length);

      if (cursor >= THOUGHTS_TOTAL) sentinel?.classList.add("hidden");
      updateStatus();
    } finally {
      busy = false;
      loadingEl?.classList.add("hidden");
    }
  }

  if (sentinel && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) void loadMoreThoughts();
        }
      },
      { root: null, rootMargin: "300px", threshold: 0 },
    );
    observer.observe(sentinel);
  }

  // --- Timeline jumps ----------------------------------------------------
  async function resolveTargetIndex(
    year?: string,
    month?: string,
  ): Promise<number> {
    if (!year) return -1;
    const yearStart = yearStartIndex.get(year);
    if (yearStart === undefined) return -1;
    if (!month) return yearStart;

    const yearThoughts = await loadYear(year);
    const offset = yearThoughts.findIndex(
      (thought: any) =>
        (new Date(thought.originalDate).getMonth() + 1).toString() === month,
    );
    return offset === -1 ? yearStart : yearStart + offset;
  }

  window.addEventListener("timeline-jump", async (event: any) => {
    const { target, year, month } = event.detail || {};

    if (target === "top") {
      window.scrollTo({ top: 0, behavior: "smooth" });
      return;
    }

    // Index-based jumps only make sense on the unfiltered stream.
    if (isFiltered()) {
      resetFilters();
      await applyFilters();
    }

    const targetIndex = await resolveTargetIndex(year, month);
    if (targetIndex === -1) return;

    if (targetIndex >= cursor) {
      if (targetIndex - cursor > 50) loadingEl?.classList.remove("hidden");
      const end = Math.min(targetIndex + 10, THOUGHTS_TOTAL);
      await ensureLoadedUntil(end - 1);
      appendRange(cursor, Math.min(end, pool.length));
      cursor = Math.min(end, pool.length);
      loadingEl?.classList.add("hidden");
      updateStatus();
    }

    const cards = feedEl?.children;
    if (cards && cards[targetIndex]) {
      (cards[targetIndex] as HTMLElement).scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }
  });

  // --- Scroll spy for the timeline rail ----------------------------------
  let spyTimer: number | undefined;

  window.addEventListener(
    "scroll",
    () => {
      if (spyTimer) window.clearTimeout(spyTimer);

      spyTimer = window.setTimeout(() => {
        const cards = document.querySelectorAll<HTMLElement>(".thought-card");
        let spyCard: HTMLElement | null = null;

        for (const card of Array.from(cards)) {
          const rect = card.getBoundingClientRect();
          if (rect.top >= 0 && rect.top < window.innerHeight / 2) {
            spyCard = card;
            break;
          }
        }

        if (!spyCard) {
          const middleY = window.innerHeight / 2;
          for (const card of Array.from(cards)) {
            const rect = card.getBoundingClientRect();
            if (rect.top < middleY && rect.bottom > middleY) {
              spyCard = card;
              break;
            }
          }
        }

        if (spyCard) {
          const dateStr = spyCard.getAttribute("data-date");
          if (dateStr) {
            const date = new Date(dateStr);
            window.dispatchEvent(
              new CustomEvent("timeline-scroll-spy", {
                detail: {
                  year: date.getFullYear().toString(),
                  month: (date.getMonth() + 1).toString(),
                },
              }),
            );
          }
        } else if (window.scrollY < 100) {
          window.dispatchEvent(
            new CustomEvent("timeline-scroll-spy", {
              detail: { year: null, month: null },
            }),
          );
        }
      }, 120);
    },
    { passive: true },
  );
</script>

<style>
  .page {
    padding-top: var(--space-12);
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .rail {
    height: 100%;
  }

  .col {
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      max-width: 820px;
    }
    .rail {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding-top: var(--space-6);
    }
    .shell {
      padding: 0 var(--space-4);
    }
  }

  /* Page head ------------------------------------------------------------- */
  .page-head {
    padding-bottom: var(--space-10);
  }

  .page-head h1 {
    font-size: clamp(3rem, 7vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 16px 0 20px;
  }

  .lede {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 54ch;
  }

  .head-stats {
    display: flex;
    gap: var(--space-10);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .head-stats dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 2px;
  }

  .head-stats dd {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  /* Activity -------------------------------------------------------------- */
  .activity {
    margin-bottom: var(--space-8);
  }

  /* Toolbar --------------------------------------------------------------- */
  .toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px 0;
    margin-bottom: 0;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .chips {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--rule);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-muted);
    flex: none;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dot, var(--ink-faint));
    flex: none;
  }

  .chip:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
  }

  .feed-status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .clear-btn {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }

  .clear-btn:hover {
    border-bottom-color: var(--accent);
  }

  /* Feed ------------------------------------------------------------------ */
  .feed > :global(.thought-card:first-child) {
    border-top: 0;
  }

  .feed.is-empty {
    border-bottom: 0;
  }

  .empty-state {
    display: block;
    padding: var(--space-16) 0;
    text-align: center;
  }

  .empty-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .empty-note {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /* Loading --------------------------------------------------------------- */
  .loading-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: var(--space-8) 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .loading-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse-dot 1s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .load-more-sentinel {
    height: 1px;
  }

  @media (max-width: 640px) {
    .toolbar {
      gap: var(--space-2);
      padding: 10px 0;
