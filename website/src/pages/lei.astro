---
// The thoughts feed used to live at /lei and is now the homepage.
// A relative redirect keeps old bookmarks working on whatever host serves this
// build, without hard-coding the canonical domain.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thoughts | Synapse</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="/" />
    <meta http-equiv="refresh" content="0; url=/" />
    <script is:inline>
      location.replace("/");
    </script>
  </head>
  <body>
    <p>This page moved. <a href="/">Continue to the archive →</a></p>
  </body>
</html>
