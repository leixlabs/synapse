---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThoughtCard from "../../components/ThoughtCard.astro";
import { loadAllThoughts } from "../../lib/thoughts-data";
import { sourceMeta } from "../../lib/sources";

export async function getStaticPaths() {
  const thoughts = await loadAllThoughts();
  const sources = [...new Set(thoughts.map((t) => t.source.toLowerCase()))];
  return sources.map((source) => {
    const meta = sourceMeta(source);
    return {
      params: { source },
      props: {
        sourceName: meta.label,
        sourceColor: meta.color,
        filteredThoughts: thoughts.filter(
          (t) => t.source.toLowerCase() === source,
        ),
      },
    };
  });
}

const { sourceName, sourceColor, filteredThoughts } = Astro.props;
---

<BaseLayout
  title={`${sourceName} thoughts`}
  description={`Every thought collected from ${sourceName}.`}
>
  <div class="page">
    <div class="inner">
      <a class="back" href="/">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M19 12H6m0 0 5.5-5.5M6 12l5.5 5.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>All thoughts</span>
      </a>

      <header class="head">
        <p class="eyebrow">Source</p>
        <h1>
          <span class="dot" style={`--dot: ${sourceColor}`} aria-hidden="true"
          ></span>{sourceName}
        </h1>
        <p class="count">{filteredThoughts.length} entries</p>
      </header>

      <div class="feed">
        {filteredThoughts.map((thought) => <ThoughtCard thought={thought as any} />)}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-12) 0 var(--space-10);
  }

  .inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  @media (max-width: 640px) {
    .inner {
      padding: 0 var(--space-4);
    }
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-8);
    transition: color 0.18s ease;
  }

  .back svg {
    width: 14px;
    height: 14px;
    transition: transform 0.18s ease;
  }

  .back:hover {
    color: var(--ink);
  }

  .back:hover svg {
    transform: translateX(-2px);
  }

  .head {
    padding-bottom: var(--space-8);
  }

  .head h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 12px 0 10px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot, var(--ink-faint));
    flex: none;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
